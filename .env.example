# Application Configuration
SECRET_KEY=change-this-to-a-secure-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (SQLite by default, or PostgreSQL/MySQL connection string)
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/rutaclara_db

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=*
